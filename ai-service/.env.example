# Incoming ASP.NET -> AI service authentication
AI_SERVICE_TOKEN=

# Shared Member 1 LLM provider
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Optional Member 2 crop/leaf image analysis (no automatic retries)
INSPECTION_IMAGE_OVERALL_TIMEOUT_SECONDS=120
INSPECTION_IMAGE_PASS1_TIMEOUT_SECONDS=30
INSPECTION_IMAGE_PASS2_TIMEOUT_SECONDS=45
INSPECTION_IMAGE_RETRIEVAL_TIMEOUT_SECONDS=35
INSPECTION_IMAGE_STAGE1_ENTRY_LIMIT=4
INSPECTION_IMAGE_STAGE1_DOCUMENT_LIMIT=6
INSPECTION_IMAGE_STAGE2_ENTRY_LIMIT=3
INSPECTION_IMAGE_STAGE2_DOCUMENT_LIMIT=4
INSPECTION_IMAGE_CANDIDATE_LINKS_PER_PAGE=20
INSPECTION_IMAGE_EVIDENCE_DOCUMENT_LIMIT=3
INSPECTION_IMAGE_EVIDENCE_CHARS_PER_SOURCE=8000
INSPECTION_IMAGE_EVIDENCE_TOTAL_CHARS=20000
INSPECTION_IMAGE_MIN_READABLE_CHARS=200
INSPECTION_IMAGE_RELEVANCE_THRESHOLD=16
INSPECTION_IMAGE_STRONG_EVIDENCE_THRESHOLD=30
INSPECTION_IMAGE_DUPLICATE_SIMILARITY=0.85

# Member 1 CropFinding uses the shared OpenAI provider/model above.
CROP_FINDING_CANDIDATE_LIMIT=8
CROP_FINDING_STAGE1_RETRIEVAL_LIMIT=5
CROP_FINDING_STAGE2_RETRIEVAL_LIMIT=3
CROP_FINDING_CONNECT_TIMEOUT_SECONDS=4
CROP_FINDING_READ_TIMEOUT_SECONDS=12
CROP_FINDING_DOCUMENT_TIMEOUT_SECONDS=18
CROP_FINDING_WEB_SEARCH_TIMEOUT_SECONDS=50
CROP_FINDING_STRUCTURED_ANALYSIS_TIMEOUT_SECONDS=70
CROP_FINDING_COMPLETION_SAFETY_MARGIN_SECONDS=5
CROP_FINDING_OVERALL_TIMEOUT_SECONDS=175
CROP_FINDING_MAX_REDIRECTS=3
CROP_FINDING_MAX_HTML_BYTES=2000000
CROP_FINDING_MAX_PDF_BYTES=10000000
CROP_FINDING_MAX_PDF_PAGES=60
CROP_FINDING_MAX_EXTRACTED_CHARS_PER_SOURCE=45000
CROP_FINDING_MAX_TOTAL_EXTRACTED_CHARS=100000
CROP_FINDING_ANALYSIS_MAX_CHARS_PER_SOURCE=12000
CROP_FINDING_ANALYSIS_MAX_TOTAL_CHARS=45000
CROP_FINDING_RETRY_COUNT=1

# AI service -> ASP.NET internal tool calls
BACKEND_TOOL_BASE_URL=http://localhost:5000
BACKEND_TOOL_TOKEN=

# Member 4 optional, read-only one-tool crop-profile retrieval (off by default)
SCHEDULING_PROFILE_RETRIEVAL_ENABLED=false

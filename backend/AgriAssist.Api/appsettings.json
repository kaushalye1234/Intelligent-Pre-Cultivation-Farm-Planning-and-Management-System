{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "Password": {
      "CompromisedPasswords": [
        "password1234",
        "qwerty123456",
        "123456789012",
        "letmein123456"
      ]
    },
    "RateLimits": {
      "Login": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      },
      "FarmerRegistration": {
        "PermitLimit": 3,
        "WindowSeconds": 3600
      },
      "TemporaryPasswordChange": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      },
      "AdminReauthentication": {
        "PermitLimit": 5,
        "WindowSeconds": 900
      },
      "AdminUserManagement": {
        "PermitLimit": 10,
        "WindowSeconds": 600
      }
    }
  },
  "AllowedHosts": "*"
}
